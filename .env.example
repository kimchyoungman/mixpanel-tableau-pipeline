# Mixpanel credentials
MIXPANEL_API_SECRET=
MIXPANEL_PROJECT_ID=
MIXPANEL_TIMEZONE=UTC

# Local paths
OUTPUT_DIR=./output
LOG_DIR=./logs
STATE_PATH=./state.json

# Tableau Cloud (Optional)
TABLEAU_SERVER_URL=https://your-pod.online.tableau.com
TABLEAU_SITE_ID=
TABLEAU_TOKEN_NAME=
TABLEAU_TOKEN_VALUE=
TABLEAU_PROJECT_NAME=Default
TABLEAU_DATASOURCE_NAME=mixpanel_hyper

# Optional: use gs://bucket/path/state.json for GCS-backed state.
# The runtime must have Google Cloud credentials with read/write access.
